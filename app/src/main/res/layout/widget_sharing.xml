<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ShareToLocate" android:textColor="#F2F7F5" android:textStyle="bold" android:textSize="17sp" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Ubicación compartida" android:textColor="#67E8B6" android:textSize="13sp" />
    <Chronometer android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:countDown="true" android:format="Tiempo restante: %s" android:textColor="#F2F7F5" android:textSize="14sp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <Button android:id="@+id/widget_duration" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="1 hora" android:textSize="12sp" />
        <Button android:id="@+id/widget_action" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="Pausar" android:textSize="12sp" />
    </LinearLayout>
    <Button android:id="@+id/widget_help" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:text="Enviar HelpTo" android:textStyle="bold" android:visibility="gone" />
</LinearLayout>
